# ==================================================
# Guchhi Backend — Environment Variables
# Copy this file to .env and fill in real values.
# ==================================================

# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
# Local docker-compose default shown below.
DATABASE_URL=postgresql://guchhi:guchhi@localhost:5432/guchhi

# --- Redis (used for cart-adjacent caching and pending checkout snapshots) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# REQUIRED, at least 32 characters, and must differ from one another.
# Generate strong random secrets, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Cookies ---
# Leave blank for localhost. Set to your apex domain in production, e.g. .guchhi.com
COOKIE_DOMAIN=

# --- CORS ---
# The plain HTML/CSS/JS frontend's origin(s). Comma-separated for multiple.
CLIENT_URL=http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Cloudinary (product image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the same secret configured in the Razorpay dashboard webhook settings.
# Required in production — used to verify POST /webhooks/razorpay signatures.
RAZORPAY_WEBHOOK_SECRET=

# --- SMTP / Nodemailer ---
# Leave SMTP_HOST blank in dev to skip sending emails (they'll just be logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Guchhi <no-reply@guchhi.com>

# --- Commerce rules ---
TAX_RATE_PERCENT=5
FREE_SHIPPING_THRESHOLD=1500
FLAT_SHIPPING_RATE=99

# --- Security ---
BCRYPT_SALT_ROUNDS=12
